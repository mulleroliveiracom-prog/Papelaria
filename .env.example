# Provedor ativo de geração e edição de imagens:
# "auto" (usa Cloudflare Workers AI se configurado; senão Google GenAI), "cloudflare-workers-ai", ou "google-genai"
AI_IMAGE_PROVIDER="auto"

# Google GenAI (Análise gratuita de sujeito + geração de imagem requer chave com faturamento ativo)
GEMINI_API_KEY=""
AI_IMAGE_MODEL="gemini-3.1-flash-lite-image"

# Cloudflare Workers AI (Alternativa com camada gratuita diária de 10.000 Neurons e suporte a múltiplas imagens de referência via FLUX.2)
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_IMAGE_MODEL="@cf/black-forest-labs/flux-1-schnell"

# Provedor de pagamento (ex: mercadopago, stripe, asaas)
PAYMENT_PROVIDER=""
PAYMENT_API_KEY=""
PAYMENT_WEBHOOK_SECRET=""
PAYMENT_WEBHOOK_URL=""

# Banco de dados e armazenamento privado de fotografias
DATABASE_DRIVER="local_persistent_json"
DATABASE_URL=""
STORAGE_PROVIDER="local_private_fs"
STORAGE_BUCKET=""
MEDIA_RETENTION_HOURS="168"

# Código de acesso do painel administrativo (opcional; se vazio, configurável no primeiro acesso)
ADMIN_ACCESS_CODE=""

# URL pública da aplicação (injetada automaticamente no runtime)
APP_URL=""
